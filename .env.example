# Polling settings
POLL_INTERVAL=10s
REQUEST_TIMEOUT=5s
MAX_RETRIES=3
BASE_RETRY_DELAY=200ms

# How old the last aggregated price can get before /health starts
# reporting 503, even if the poller never set the explicit stale flag
# (e.g. it hung). Defaults to 3x POLL_INTERVAL if unset.
STALE_THRESHOLD=30s

# HTTP server
PORT=8080